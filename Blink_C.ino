#include <avr/io.h>     // Библиотека ввода-вывода для AVR
#include <util/delay.h> // Библиотека для организации задержек

#define LED_PIN DDB0    // Указываем бит 0 (соответствует PB0 / ножка 5)

int main(void) {
    // 1. Настраиваем пин PB0 на выход.
    // Сдвигаем единицу влево на позицию DDB0 и устанавливаем бит в регистре DDRB.
    DDRB |= (1 << LED_PIN);

    while (1) {
        // 2. Включаем светодиод (подаем высокий уровень на PB0)
        PORTB |= (1 << LED_PIN);
        _delay_ms(500); // Задержка 500 мс

        // 3. Выключаем светодиод (сбрасываем бит в регистре PORTB в 0)
        PORTB &= ~(1 << LED_PIN);
        _delay_ms(500); // Задержка 500 мс
    }
}
